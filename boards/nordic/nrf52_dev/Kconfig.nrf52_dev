config BOARD_NRF52_DEV
	select SOC_NRF52805_CAAA if BOARD_NRF52_DEV_NRF52805
	select SOC_NRF52810_QFAA if BOARD_NRF52_DEV_NRF52810
	select SOC_NRF52832_QFAA if BOARD_NRF52_DEV_NRF52832
