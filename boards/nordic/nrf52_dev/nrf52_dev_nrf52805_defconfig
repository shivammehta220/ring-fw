# Enable MPU
CONFIG_ARM_MPU=y

# Enable GPIO
CONFIG_GPIO=y

# Enable I2C driver
CONFIG_I2C=y

# Enable UART driver for logging
CONFIG_SERIAL=y

# Enable console
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# Bluetooth not enabled by default on nRF52805 due to RAM limitations when
# running the default set of kernel tests.
